# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/mideudor?schema=public"

# Auth.js / NextAuth Security
AUTH_SECRET="your-super-secret-key-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Admin Initial Credentials
ADMIN_DEFAULT_EMAIL="admin@mideudor.com"
ADMIN_DEFAULT_PASSWORD="AdminSecurePassword2026!"

# Risk Score Algorithm Config
RISK_SCORE_MAX_DEBT_REFERENCE="50000000"
RISK_SCORE_MAX_CREDITORS_REFERENCE="10"

# Notification Service (SMTP / Resend)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="notificaciones@mideudor.com"
